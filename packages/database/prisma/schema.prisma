// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderSide {
  long
  short
}

enum OrderType {
  market
  limit
}

enum OrderStatus {
  resting
  filled
  cancelled
  partially_filled
  rejected
}

enum FillRole {
  maker
  taker
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  fills  Fill[]
}

model Market {
  id            String  @id @default(uuid())
  slug          String  @unique
  baseCurrency  String
  quoteCurrency String
  imageUrl      String?

  tickSize              Float
  minOrderSize          Float // min order quantity
  maxOrderSize          Float // max order quantity
  maxLeverage           Int
  makerFeeRate          Float
  takerFeeRate          Float
  maintenanceMarginRate Int // minimum balance to maintain otherwise it get's liquidated like 0.5%
  initialMarginRate     Int // minimum balance to open an order like 1%
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())

  orders Order[]
  fills  Fill[]
}

model Order {
  id       String      @id @default(uuid())
  userId   String
  marketId String
  side     OrderSide
  type     OrderType
  status   OrderStatus

  qty          Float
  price        Float?
  filledQty    Float  @default(0)
  remainingQty Float

  leverage  Int      @default(1)
  slippage  Int // max allowed slippage for market orders
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postOnly        Boolean @default(false)
  rejectionReason String?

  user   User   @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])
  fills  Fill[]

  @@index([userId])
}

model Fill {
  id        String    @id @default(uuid())
  orderId   String
  userId    String
  marketId  String
  side      OrderSide
  role      FillRole // maker or taker
  quantity  Float
  price     Float
  fee       Float     @default(0)
  createdAt DateTime  @default(now())

  order  Order  @relation(fields: [orderId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([marketId])
}
